# RDP target. Never commit real credentials.
RDP_HOST=192.0.2.10
RDP_PORT=3389
RDP_USERNAME=automation-user
RDP_PASSWORD=replace-me
RDP_DOMAIN=
RDP_AUTH=ntlm
RDP_WIDTH=1920
RDP_HEIGHT=1080

# OpenAI-compatible vision endpoint (for example, a local vLLM server).
CUA_VISION_BASE_URL=http://127.0.0.1:8000/v1
CUA_VISION_MODEL=your-vision-model
CUA_VISION_API_KEY=not-required

# Runtime safety limits.
CUA_MAX_STEPS=30
CUA_ACTION_TIMEOUT_SECONDS=30
CUA_REPEAT_ACTION_LIMIT=2
CUA_OBSERVATION_TIMEOUT_SECONDS=15
CUA_MODEL_TIMEOUT_SECONDS=60
CUA_SETTLE_SECONDS=0.3
